# Copiar a .env y llenar con valores reales. Nunca se comitea .env
# (regla de trabajo 10 — ver .gitignore).

# --- Backend (config/settings/production.py) --------------------------
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=api.elpatojismo.example.org
DATABASE_URL=postgres://usuario:password@host-neon/nombre_bd?sslmode=require
CORS_ALLOWED_ORIGINS=https://portal.elpatojismo.example.org
# Almacenamiento de objetos de Neon (compatible con S3): documentos de
# justificación y PDF emitidos. Con AWS_ENDPOINT_URL_S3 definido se usa;
# sin él, los archivos van a backend/media/. `neon deploy` los escribe en
# .env.local (nunca se comitea).
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=justificaciones
DATABASE_URL_UNPOOLED=

# --- Frontend (frontend/.env) ------------------------------------------
VITE_API_BASE_URL=https://api.elpatojismo.example.org/api/v1
